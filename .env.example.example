# Telegram API Credentials (get from my.telegram.org)
API_ID=your_api_id
API_HASH=your_api_hash

# For Railway, generate this using 'python get_session.py'
STRING_SESSION=your_generated_string_session

# Source Channel Configuration
# (Numerical ID of the channel you want to monitor)
SOURCE_CHANNEL_ID=-100xxxxxxxxxx

# Target Alert Bot Configuration
TARGET_BOT_TOKEN=your_bot_token
TARGET_CHAT_ID=your_chat_id
